--- !u!114 &244522544
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 244522539}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6198b4674715944b805e4bec1774e6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  velocidadDeMovimiento: 150
  suavizadoDeMovimiento: 0
  imagenDialogo: {fileID: 121531563}
  textoDialogo: {fileID: 760261666}
  audioSource: {fileID: 621694865}
  velocidadEscritura: 0.02
  botonSaltar: {fileID: 1971455090}
  escenasDialogo:
  - imagen: {fileID: 21300000, guid: e4dff8204d55c04489ad32c551122707, type: 3}
    dialogo: "Muy buenos d\xEDas inspector MAX, estoy leyendo en el peri\xF3dico
      y el articulo dice que se robaron el cuadro \u201CLA NOCHE ESTRELLADA\u201D
      entre la noche de ayer y la madrugada de hoy."
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 3
    tiempoExtraLectura: 4
  - imagen: {fileID: 21300000, guid: b155afab5e189554c9f83e7c51953bb3, type: 3}
    dialogo: "Si mi estimado, mi compa\xF1ero LEO LUPA, est\xE1 esper\xE1ndome en
      el lugar del crimen, voy camino al museo Louvre, a solucionar este misterio."
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 3
    tiempoExtraLectura: 5
  - imagen: {fileID: 21300000, guid: e4dff8204d55c04489ad32c551122707, type: 3}
    dialogo: "Inspector yo paso aqu\xED siempre y me parece extra\xF1o, porque nunca
      vi salir a nadie sospechoso con algo de las dimensiones del cuadro."
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 3
    tiempoExtraLectura: 6
  - imagen: {fileID: 21300000, guid: 57f94cc1e8daa224fb0b0ab124f2f433, type: 3}
    dialogo: Mmm muy interesante, aun mas sospechoso.
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 2
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: e4dff8204d55c04489ad32c551122707, type: 3}
    dialogo: "Bueno inspector suerte no lo atraso m\xE1s."
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 2
    tiempoExtraLectura: 3
  - imagen: {fileID: 21300000, guid: 32b586545f0765b4db7f240db58549f9, type: 3}
    dialogo: "Gracias por su valiosa informaci\xF3n."
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 2
    tiempoExtraLectura: 3
