MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1373514502}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6197b419c1e48df4ca5d5419877926ef, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  imagenUI: {fileID: 8195772}
  textoUI: {fileID: 556917595}
  audioSource: {fileID: 249466842}
  telefonoAudioSource: {fileID: 1334925673}
  telefonoAnimacion: {fileID: 891109657}
  imagenADesaparecer: {fileID: 1837558404}
  escenas:
  - imagen: {fileID: 21300000, guid: ce679d14e3fb9674b9b235f9c44205c5, type: 3}
    dialogo: 
    sonido: {fileID: 0}
    duracion: 1
    activarTelefono: 0
    tiempoAparicionTelefono: 0
    duracionTelefono: 0
    sonidoTelefono: {fileID: 0}
    tiempoExtraLectura: 0
  - imagen: {fileID: 21300000, guid: c9039a3bb2316e946aa40fbb0ed194cc, type: 3}
    dialogo: "Buenos d\xEDas, Inspector MAX disculpe la tardanza. Pondr\xE9 en orden
      la oficina."
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 2
    activarTelefono: 0
    tiempoAparicionTelefono: 0
    duracionTelefono: 0
    sonidoTelefono: {fileID: 0}
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: f5005bc404c724e408ca10c35e76cddd, type: 3}
    dialogo: "Buenos d\xEDas, LEO todo tranquilo ya he ordenado todo."
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 2
    activarTelefono: 0
    tiempoAparicionTelefono: 0
    duracionTelefono: 0
    sonidoTelefono: {fileID: 0}
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: c9039a3bb2316e946aa40fbb0ed194cc, type: 3}
    dialogo: "Muchas gracias Inspector. Y para este d\xEDa que nueva misi\xF3n tenemos."
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 2
    activarTelefono: 0
    tiempoAparicionTelefono: 0
    duracionTelefono: 0
    sonidoTelefono: {fileID: 0}
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: f5005bc404c724e408ca10c35e76cddd, type: 3}
    dialogo: "Por el momento nada, pero sabemos que el crimen no descansa y en alg\xFAn
      lugar de esta ciudad se est\xE1 cometiendo un crimen."
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 2
    activarTelefono: 1
    tiempoAparicionTelefono: 0.5
    duracionTelefono: 1
    sonidoTelefono: {fileID: 8300000, guid: c7c5b33874f912840800135ffca15c40, type: 3}
    tiempoExtraLectura: 3
  - imagen: {fileID: 21300000, guid: dcb0c169ca787914688172610e9437ae, type: 3}
    dialogo: Si Alo oficinas del Inspector MAX MISTERIO, en que podemos ayudarle.
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 1.5
    activarTelefono: 0
    tiempoAparicionTelefono: 0
    duracionTelefono: 0
    sonidoTelefono: {fileID: 0}
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: dcb0c169ca787914688172610e9437ae, type: 3}
    dialogo: "Si claro le informare al inspector del suceso. Pronto estaremos por
      ah\xED."
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 1.5
    activarTelefono: 0
    tiempoAparicionTelefono: 0
    duracionTelefono: 0
    sonidoTelefono: {fileID: 0}
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: f5005bc404c724e408ca10c35e76cddd, type: 3}
    dialogo: "Que sucede LEO quien era al tel\xE9fono. "
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 1.5
    activarTelefono: 0
    tiempoAparicionTelefono: 0
    duracionTelefono: 0
    sonidoTelefono: {fileID: 0}
    tiempoExtraLectura: 1
  - imagen: {fileID: 21300000, guid: c9039a3bb2316e946aa40fbb0ed194cc, type: 3}
    dialogo: Era la gerencia del Museo Louvre, informando sobre la perdida de un
      valioso cuadro LA NOCHE ESTRELLADA. Y solicitan nuestra ayuda.
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 2
    activarTelefono: 0
    tiempoAparicionTelefono: 0
    duracionTelefono: 0
    sonidoTelefono: {fileID: 0}
    tiempoExtraLectura: 3
  - imagen: {fileID: 21300000, guid: 77604e4bb087b7647b9f7d5f0307fd3f, type: 3}
    dialogo: 'Mmm ese cuadro es muy valioso he invaluable. Recojamos nuestras cosas
      y vamos al museo a investigar antes que desaparezca por completo esa obra de
      arte. '
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 2
    activarTelefono: 0
    tiempoAparicionTelefono: 0
    duracionTelefono: 0
    sonidoTelefono: {fileID: 0}
    tiempoExtraLectura: 3
  - imagen: {fileID: 21300000, guid: 7a592f2a1717e4c478b83d5c05990ac8, type: 3}
    dialogo: "Ay\xFAdanos a encontrar nuestro equipo de Investigacion."
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 0.5
    activarTelefono: 0
    tiempoAparicionTelefono: 0
    duracionTelefono: 0
    sonidoTelefono: {fileID: 0}
    tiempoExtraLectura: 2
  siguienteEscena: 
  velocidadTexto: 0.01
  botonSaltar: {fileID: 413664836}
