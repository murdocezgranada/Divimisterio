--- !u!114 &1856440802
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1856440801}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2918ffce6a9173d4e8fd6ba31a80aa2c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  imagenUI: {fileID: 126008316}
  textoUI: {fileID: 353013835}
  audioSource: {fileID: 1835723128}
  escenas:
  - imagen: {fileID: 21300000, guid: cf7b190b47d4e1a4db453049dd2b6b8e, type: 3}
    dialogo: 
    sonido: {fileID: 0}
    duracion: 1
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: 16639ffc22f068945becf9a4f82399cb, type: 3}
    dialogo: 
    sonido: {fileID: 0}
    duracion: 2
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: b1e43083a5f0eb94d834a35a36cc44f0, type: 3}
    dialogo: Hola inspector muchas gracias por venir, me llamo Elvis Tek y soy el
      gerente del museo.
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 3
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: 3811e573e628cc0479a7ca7bc4260f0a, type: 3}
    dialogo: "Nos llamaron y comentan que se robaron un valioso cuadro \u201CLa Noche
      Estrellada\u201D "
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 5
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: df98b18769ef3dc4f8a9432f2b9d449f, type: 3}
    dialogo: "Si inspector y necesitamos que nos ayude a resolver este robo, el museo
      est\xE1 pasando problemas y con esta perdida, ser\xEDa grave."
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 4
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: 3811e573e628cc0479a7ca7bc4260f0a, type: 3}
    dialogo: Y quienes son los que estaban a la hora del robo o la hora que se dieron
      cuenta que no estaba el cuadro.
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 5
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: df98b18769ef3dc4f8a9432f2b9d449f, type: 3}
    dialogo: "A esa hora estaba la restauradora de arte, el de mantenimiento fue
      el primero en avisarme, y el de seguridad, ellos ya vienen para ac\xE1 para
      que los conozca."
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 5
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: fd3f3b1b816b58541ab23c6d7616c738, type: 3}
    dialogo: Ellos son, Mario Neta de Seguridad, Elva Lazo la restauradora y Yono
      Fui de mantenimiento.
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 5
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: 57f94cc1e8daa224fb0b0ab124f2f433, type: 3}
    dialogo: "Un placer conocerlos , ya conversare con cada uno de ustedes para recopilar
      informaci\xF3n para armar este misterio."
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 5
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: f4403d1716fe6fb4095f8f7b494b83f8, type: 3}
    dialogo: "Tu eres Yono Fui y tu trabajo aqu\xED es de mantenimiento , imagino
      que tienes acceso a todos el mueseo."
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 5
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: a02ec62081a9736479cf9a1341542933, type: 3}
    dialogo: Mmmm.
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 3
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: 11771120e5fcd5341a49786493295c50, type: 3}
    dialogo: "Si se\xF1or yo le avise al gerente que no estaba el retrato, y si tengo
      acceso a todo el local y doy mantenimiento al museo lo pinto y reparo todo."
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 5
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: 3811e573e628cc0479a7ca7bc4260f0a, type: 3}
    dialogo: Muchas Gracias.
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 2
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: 3811e573e628cc0479a7ca7bc4260f0a, type: 3}
    dialogo: "Tu eres Elva Lazo y de que trabajas aqu\xED."
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 3
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: 8c550f93fb360514c885d724ac9f9f3f, type: 3}
    dialogo: "Si se\xF1or y mi \xE1rea es de restauraci\xF3n y hace poco restaure
      el cuadro que se extravi\xF3."
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 5
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: 9bc1942ba6ed6194ca21f05f21253c9f, type: 3}
    dialogo: Gracias por su informacion
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 4
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: 57f94cc1e8daa224fb0b0ab124f2f433, type: 3}
    dialogo: Y usted es Mario Neta de Seguridad
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 2
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: a73f044c37ca19f45b173c21448094cd, type: 3}
    dialogo: "Si se\xF1or y como lo dijo soy de seguridad controlo las c\xE1maras
      y la entrada y salida de personal."
    sonido: {fileID: 8300000, guid: 5e4fa477f72b76c479d9ae082b351644, type: 3}
    duracion: 4
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: 32771e4d655f0a047ad937b44fe7dfef, type: 3}
    dialogo: Mmmmm. muchas gracias.
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 4
    tiempoExtraLectura: 2
  - imagen: {fileID: 21300000, guid: 32b586545f0765b4db7f240db58549f9, type: 3}
    dialogo: "Bueno ir\xE9 a buscar pistas, acomp\xE1\xF1ame para resolver este misterio."
    sonido: {fileID: 8300000, guid: b6f336c1ba4a3d44e81231f081564fcc, type: 3}
    duracion: 4
    tiempoExtraLectura: 2
  siguienteEscena: 
  velocidadTexto: 0.02
  botonSaltar: {fileID: 1951930539}
